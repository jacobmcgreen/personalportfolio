# Optional: higher GitHub API rate limit for /api/commits
# Create at https://github.com/settings/tokens (public_repo or no scopes needed for public events)
GITHUB_TOKEN=

# Required for durable guestbook on Vercel (Upstash Redis / Vercel KV)
# Create via Vercel Dashboard → Storage → create KV/Redis, then connect to this project.
# Vercel injects these automatically when the store is linked:
KV_REST_API_URL=
KV_REST_API_TOKEN=
